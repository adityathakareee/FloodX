# ==============================================================================
# FLOOD-X — Root Environment Configuration Template
# Project: FLOOD-X — AI-Powered Flood Intelligence & Emergency Decision Support
# Target Region: Pune / Mula-Mutha River Basin, Maharashtra, India
# Phase: Phase 0 (Project Foundation & System Architecture)
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="FLOOD-X Intelligence Engine"
PROJECT_TAGLINE="PREDICT | PRIORITIZE | PROTECT"
APP_VERSION=0.1.0-phase0

# ------------------------------------------------------------------------------
# PostgreSQL / PostGIS Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=floodx_admin
POSTGRES_PASSWORD=floodx_secret_change_in_prod
POSTGRES_DB=floodx_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://floodx_admin:floodx_secret_change_in_prod@localhost:5432/floodx_db

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8081"]
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Administrative Authority Credentials (Phase 3.2 Security Hardening)
# ------------------------------------------------------------------------------
# Loaded exclusively from environment variable; DO NOT hardcode or commit secrets.
# Required for protected municipal write endpoints: POST/PATCH/DELETE closures & shelters.
# Generate a strong 256-bit random token in your secure environment:
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOODX_AUTHORITY_TOKEN=
FLOODX_OPERATOR_TOKEN=

# ------------------------------------------------------------------------------
# Frontend Dashboard Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="FLOOD-X — Pune Basin Intelligence"

# ------------------------------------------------------------------------------
# Mobile Application Configuration (Expo / React Native)
# ------------------------------------------------------------------------------
# For Android Emulator use: http://10.0.2.2:8000/api/v1
# For Physical Android device on LAN use your PC IP: http://192.168.x.x:8000/api/v1
# For iOS Simulator use: http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_APP_REGION="Pune / Mula-Mutha Basin"

